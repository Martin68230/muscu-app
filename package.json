{
  "name": "muscu-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/make-credits.mjs && node tools/build-fiches.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "screens": "playwright test",
    "icons": "node tools/make-icons.mjs",
    "check:fiches": "node tools/validate-fiches.mjs",
    "check:securite": "node tools/check-securite.mjs",
