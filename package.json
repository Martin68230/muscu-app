    "credits": "node tools/make-credits.mjs",
    "page:images": "node tools/page-images.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
